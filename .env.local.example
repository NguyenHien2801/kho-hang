# Supabase - lấy từ https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# AI - Grok API hoặc Claude API
# Dùng Grok: lấy từ https://console.x.ai
GROK_API_KEY=xai-your-grok-key
# Hoặc dùng Claude: lấy từ https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-your-key

# Chọn AI provider: "grok" hoặc "claude"
AI_PROVIDER=grok

# Telegram Bot - tạo qua @BotFather trên Telegram
TELEGRAM_BOT_TOKEN=your-bot-token
TELEGRAM_CHAT_ID=your-chat-id

# Zalo OA - lấy từ https://developers.zalo.me
ZALO_ACCESS_TOKEN=your-zalo-token
ZALO_USER_ID=your-zalo-user-id

# Ngưỡng cảnh báo (ngày)
ALERT_WARNING_DAYS=10
ALERT_CRITICAL_DAYS=3
